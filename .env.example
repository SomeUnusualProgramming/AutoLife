# LifeAI Environment Variables for Docker Compose
# Copy to .env and update as needed

# OpenAI Configuration (optional, if using for recommendations)
OPENAI_API_KEY=sk-...

# STT Service Configuration
WHISPER_MODEL_SIZE=base
# Options: tiny (40MB), base (140MB), small (465MB), medium (1.5GB), large (3GB)

# Logging
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR

# Debug Mode
DEBUG=False

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lifeai

# Backend
SPRING_PROFILES_ACTIVE=dev
STT_SERVICE_URL=http://stt:5000

# Frontend
VITE_API_URL=http://localhost:8080
